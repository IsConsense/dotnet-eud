{
  "build": {
    "content": [
      {
        "files": [
            "reporting-for-desktop/**/*.{md,yml}",
            "interface-elements-for-desktop/images/**",
            "toc.yml",
            "index.md"
          ],
        "exclude": [
          "_*/**",
        ]
      }
    ],
    "resource": [
      {
        "files": [
            "favicon.ico",
            "logo_cns.png",
            "reporting-for-desktop/images/**",
            "interface-elements-for-desktop/images/**"
          ],
          "exclude": [
            "_*/**"
          ]
      }
    ],
    "output": "_site",
    "template": [
      "default",
      "modern",
      "./.template"
    ],
    "sitemap": {
      "baseUrl": "https://consense.is/"
    },
    "globalMetadata": {
      "_appName": "Revit Report Designer",
      "_appTitle": "End-User Documentation",
      "_appFaviconPath": "favicon.ico",
      "_appFooter": "Copyright (c) 1998-2024 Developer Express Inc. All rights reserved.",
      "_appLogoPath": "logo_cns.png",
      "_enableSearch": true
    }
  }
}
